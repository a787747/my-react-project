# API Configuration
# Замените на реальный URL вашего API сервера
VITE_API_URL=https://your-api-domain.com/webhook

# Только для локального запуска dump_n8n.py
N8N_URL=https://your-n8n-domain.com
N8N_API_KEY=replace-with-a-local-n8n-api-key
N8N_OUTPUT_DIR=./n8n_workflows

# Server-only n8n environment. Password-reset emails refuse non-HTTPS origins.
EPE_FRONTEND_URL=https://epe.example.com

# Примечания:
# - Используйте HTTPS в production
# - Не коммитьте .env файл с реальными данными
# - Скопируйте этот файл в .env и заполните значения
