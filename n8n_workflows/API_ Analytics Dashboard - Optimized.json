    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  ep.name as period_name,\n  COUNT(e.id) as evaluations_count,\n  ROUND(AVG(e.calculated_score)::numeric, 2) as avg_score,\n  TO_CHAR(ep.start_date, 'YYYY-MM-DD') as start_date\nFROM performance_db.evaluations e\nINNER JOIN performance_db.evaluation_periods ep ON e.period_id = ep.id\nWHERE e.calculated_score IS NOT NULL\nGROUP BY ep.id, ep.name, ep.start_date\nORDER BY ep.start_date DESC\nLIMIT 12",
        "options": {}
      },
      "name": "Get Period Trends",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1456,
        -128
      ],
      "id": "2f667685-e150-48b7-9850-c0aba291b41c",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const overallItems = $('Get Overall Stats').all();\nconst deptItems = $('Get Department Stats').all();\nconst topItems = $('Get Top Performers').all();\nconst lowItems = $('Get Low Performers').all();\nconst trendItems = $('Get Period Trends').all();\n\nreturn {\n  json: {\n    success: true,\n    data: {\n      overall: overallItems && overallItems.length > 0 ? overallItems[0].json : {\n        total_evaluations: 0,\n        company_avg_score: 0,\n        total_employees: 0,\n        active_evaluators: 0\n      },\n      departments: deptItems ? deptItems.map(i => i.json) : [],\n      top_performers: topItems ? topItems.map(i => i.json) : [],\n      low_performers: lowItems ? lowItems.map(i => i.json) : [],\n      period_trends: trendItems ? trendItems.map(i => i.json) : []\n    }\n  }\n};"
      },
