    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  COUNT(DISTINCT e.id) as total_evaluations,\n  COALESCE(ROUND(AVG(e.calculated_score)::numeric, 2), 0) as company_avg_score,\n  COUNT(DISTINCT e.subject_id) as total_employees,\n  COUNT(DISTINCT e.evaluator_id) as active_evaluators\nFROM performance_db.evaluations e\nWHERE e.calculated_score IS NOT NULL",
        "options": {}
      },
      "name": "Get Overall Stats",
