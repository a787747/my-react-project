    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  COALESCE(d.name, 'Без отдела') as department,\n  COUNT(e.id) as evaluations_count,\n  ROUND(AVG(e.calculated_score)::numeric, 2) as avg_score\nFROM performance_db.evaluations e\nINNER JOIN performance_db.users u ON e.subject_id = u.id\nLEFT JOIN performance_db.departments d ON u.department_id = d.id\nWHERE e.calculated_score IS NOT NULL\nGROUP BY d.name\nORDER BY avg_score DESC NULLS LAST",
        "options": {}
      },
      "name": "Get Department Stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        256,
        -128
      ],
      "id": "c56eb8e8-8838-4dd0-8575-3a38dc680419",
      "alwaysOutputData": true,
