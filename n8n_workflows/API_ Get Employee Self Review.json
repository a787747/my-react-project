    {
      "parameters": {
        "jsCode": "const query = $input.item.json.query;\nconst params = $input.item.json.params;\n\nlet subjectId = null;\n\nif (query && query.subject_id) {\n  subjectId = query.subject_id;\n} else if (params && params.subject_id) {\n  subjectId = params.subject_id;\n}\n\nif (!subjectId) {\n  throw new Error('subject_id is required');\n}\n\nreturn {\n  json: { subject_id: parseInt(subjectId) }\n};"
      },
      "id": "9935f608-b226-4b0b-bd2b-fdf8370c1e0d",
      "name": "Extract Subject ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -320,
        -112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM performance_db.evaluation_periods WHERE is_active = true LIMIT 1",
        "options": {}
      },
      "id": "a069e485-5eb5-4d7f-baf2-f9b1928b8848",
      "name": "Get Active Period",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -96,
        -112
      ],
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, calculated_score, updated_at\nFROM performance_db.evaluations\nWHERE subject_id = {{ $('Extract Subject ID').item.json.subject_id }}\n  AND evaluator_id = {{ $('Extract Subject ID').item.json.subject_id }}\n  AND period_id = {{ $json.id }}\n  AND evaluation_type = 'self'\nORDER BY updated_at DESC\nLIMIT 1",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "0c6c1b29-7d03-43bb-bc7f-2e2556840a59",
      "name": "Get Self Review",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        128,
        -112
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT \n  es.criteria_id,\n  es.score_value,\n  es.comment,\n  c.title as criteria_title\nFROM performance_db.evaluation_scores es\nLEFT JOIN performance_db.criteria c ON es.criteria_id = c.id\nWHERE es.evaluation_id = {{ $json.id }}",
        "options": {}
      },
      "id": "dfc5e618-386c-455e-a0a7-8049e3c2928f",
      "name": "Get Scores",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        336,
        -112
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const selfReview = $('Get Self Review').all();\nconst scores = $input.all();\n\nif (!selfReview || selfReview.length === 0 || !selfReview[0].json.id) {\n  return {\n    json: {\n      has_self_review: false,\n      evaluation_id: null,\n      score: null,\n      scores: {},\n      comments: {}\n    }\n  };\n}\n\nconst review = selfReview[0].json;\nconst scoresMap = {};\nconst commentsMap = {};\n\nscores.forEach(item => {\n  if (item.json.criteria_id) {\n    scoresMap[item.json.criteria_id] = item.json.score_value;\n    if (item.json.comment) {\n      commentsMap[item.json.criteria_id] = item.json.comment;\n    }\n  }\n});\n\nreturn {\n  json: {\n    has_self_review: true,\n    evaluation_id: review.id,\n    total_score: review.calculated_score,\n    updated_at: review.updated_at,\n    scores: scoresMap,\n    comments: commentsMap\n  }\n};"
      },
