    },
    {
      "parameters": {
        "jsCode": "const request = $input.first().json;\nreturn {\n  json: {\n    authorization: request.headers?.authorization || '',\n    required_roles: ['admin', 'c_level', 'manager'],\n    required_capability: 'can_evaluate',\n    request,\n  },\n};"
      },
      "id": "employees-guard-input",
      "name": "Prepare Guard Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": "L0Zr7nVa8O5YWXd3",
        "options": {}
      },
      "id": "employees-run-guard",
      "name": "Run Auth Guard",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        -250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const guard = $input.first().json;\nif (!guard.ok) return { json: guard };\nconst actorId = Number(guard.identity.id);\nreturn {\n  json: {\n    ...guard,\n    sql: `\n      SELECT\n        users.id,\n        users.full_name,\n        users.email,\n        users.job_title,\n        users.work_category,\n        users.is_project_participant,\n        users.manager_id,\n        users.has_subordinates,\n        departments.name AS department_name,\n        grades.code AS grade_code,\n        grades.coefficient AS grade_coefficient\n      FROM performance_db.users users\n      LEFT JOIN performance_db.departments departments\n        ON users.department_id = departments.id\n      LEFT JOIN performance_db.grades grades\n        ON users.grade_id = grades.id\n      WHERE users.manager_id = ${actorId}\n      ORDER BY users.full_name\n    `,\n  },\n};"
      },
      "id": "employees-build",
      "name": "Build Identity-Bound Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.ok ? $json.sql : 'SELECT NULL::integer AS id WHERE false' }}",
        "options": {}
      },
      "id": "employees-query",
      "name": "Load Actor Subordinates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const guard = $('Run Auth Guard').first().json;\nif (!guard.ok) {\n  return {\n    json: {\n      http_status: guard.status,\n      body: {\n        success: false,\n        error: guard.code,\n        message: guard.message,\n      },\n    },\n  };\n}\n\nconst employees = $input.all()\n  .map(item => item.json)\n  .filter(item => item.id !== undefined);\n\nreturn {\n  json: {\n    http_status: 200,\n    body: {\n      success: true,\n      actor_user_id: guard.identity.id,\n      data: employees,\n    },\n  },\n};"
      },
      "id": "employees-format",
      "name": "Format Response",
