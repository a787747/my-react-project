        -700,
        0
      ],
      "webhookId": "epe-score-coefficients-get"
    },
    {
      "parameters": {
        "jsCode": "const request = $input.first().json;\nreturn {\n  json: {\n    authorization: request.headers?.authorization || '',\n    required_roles: [\"admin\"],\n    required_capability: \"\",\n    request,\n  },\n};"
      },
      "id": "scorecoeff-guard-input",
      "name": "Prepare Guard Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": "L0Zr7nVa8O5YWXd3",
        "options": {}
      },
      "id": "scorecoeff-run-guard",
      "name": "Run Auth Guard",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        -250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const guard = $('Run Auth Guard').first().json;\nif (!guard.ok) {\n  return {\n    json: {\n      http_status: guard.status,\n      body: { success: false, error: guard.code, message: guard.message },\n    },\n  };\n}\nreturn {\n  json: {\n    ok: true,\n    sql: `\n      SELECT c.id, c.title, c.weight, c.is_active,\n        COALESCE(\n          (SELECT json_agg(json_build_object('score_level', sc.score_level, 'coefficient', sc.coefficient) ORDER BY sc.score_level)\n           FROM performance_db.score_coefficients sc WHERE sc.criteria_id = c.id),\n          '[]'::json\n        ) AS score_coefficients_raw\n      FROM performance_db.criteria c\n      WHERE c.is_active = true\n      ORDER BY c.id ASC\n    `,\n  },\n};"
      },
      "id": "scorecoeff-build",
      "name": "Build Coefficients Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.ok ? $json.sql : 'SELECT NULL::integer AS id WHERE false' }}",
        "options": {}
      },
      "id": "scorecoeff-query",
      "name": "Load Coefficients",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const guard = $('Run Auth Guard').first().json;\nif (!guard.ok) {\n  return {\n    json: {\n      http_status: guard.status,\n      body: { success: false, error: guard.code, message: guard.message },\n    },\n  };\n}\nconst rows = $input.all().map(item => item.json).filter(item => item.id !== undefined);\nconst data = rows.map(row => {\n  let rawCoeffs = row.score_coefficients_raw;\n  if (typeof rawCoeffs === 'string') {\n    try { rawCoeffs = JSON.parse(rawCoeffs); } catch { rawCoeffs = []; }\n  }\n  const coeffMap = {};\n  for (let i = 1; i <= 10; i++) {\n    const found = rawCoeffs.find(c => c.score_level === i);\n    coeffMap[i] = found ? parseFloat(found.coefficient) : 1.0;\n  }\n  return {\n    id: row.id,\n    title: row.title,\n    weight: parseFloat(row.weight) || 1.0,\n    is_active: row.is_active,\n    score_coefficients: coeffMap,\n  };\n});\nreturn {\n  json: {\n    http_status: 200,\n    body: { success: true, data },\n  },\n};"
      },
      "id": "scorecoeff-format",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
