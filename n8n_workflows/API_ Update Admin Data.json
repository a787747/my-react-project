    {
      "parameters": {
        "jsCode": "// Генерируем SQL запросы для обновления\nconst body = $input.item.json.body;\nconst grades = body.grades || [];\nconst settings = body.settings || [];\n\nlet sqlQueries = [];\n\n// 1. Обновляем Грейды\nfor (const g of grades) {\n  if (g.id && g.coefficient !== undefined) {\n     sqlQueries.push(`UPDATE performance_db.grades SET coefficient = ${g.coefficient} WHERE id = ${g.id};`);\n  }\n}\n\n// 2. Обновляем Настройки\nfor (const s of settings) {\n  if (s.setting_key && s.setting_value !== undefined) {\n    sqlQueries.push(`UPDATE performance_db.global_settings SET setting_value = ${s.setting_value} WHERE setting_key = '${s.setting_key}';`);\n  }\n}\n\nconst finalQuery = sqlQueries.join('\\n');\n\nreturn {\n  json: {\n    query: finalQuery,\n    count: sqlQueries.length\n  }\n};"
      },
      "id": "21bcaab8-9073-4f42-9621-78038bb1bb21",
