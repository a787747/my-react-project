  "name": "API: Verify Code",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "api/verify-code",
        "responseMode": "lastNode",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "2c8d0f9f-cedb-46f6-bab9-ca2af4b547b0",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1296,
        -16
      ],
      "webhookId": "verify-code-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\n\nconst email = body.email?.toLowerCase().trim();\nconst code = body.code?.trim();\n\nif (!email || !code) {\n  throw new Error('Email and code are required');\n}\n\nif (code.length !== 6 || !/^\\d+$/.test(code)) {\n  throw new Error('Invalid code format');\n}\n\nconst safeEmail = email.replace(/'/g, \"''\");\n\nreturn {\n  json: {\n    email: email,\n    safe_email: safeEmail,\n    code: code\n  }\n};"
      },
      "id": "5a7538c9-cfa6-40dd-a61d-05b81f278a9a",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1072,
        -16
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, code, attempts\nFROM performance_db.email_verification_codes\nWHERE LOWER(email) = LOWER('{{ $json.safe_email }}')\n  AND is_verified = false\n  AND expires_at > NOW()\nORDER BY created_at DESC\nLIMIT 1",
        "options": {}
      },
      "id": "d77e3582-3beb-498a-82c3-a48b33c5f09c",
      "name": "Find Code",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -848,
        -16
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all();\nconst codeRecord = results.length > 0 ? results[0].json : null;\nconst inputData = $('Validate Input').first().json;\n\nif (!codeRecord || !codeRecord.id) {\n  throw new Error('No valid verification code found. Please request a new code.');\n}\n\n// Проверяем количество попыток (макс 5)\nif (codeRecord.attempts >= 5) {\n  throw new Error('Too many attempts. Please request a new code.');\n}\n\n// Проверяем код\nif (codeRecord.code !== inputData.code) {\n  // Увеличиваем счетчик попыток\n  return {\n    json: {\n      ...inputData,\n      code_id: codeRecord.id,\n      is_valid: false,\n      attempts: codeRecord.attempts + 1\n    }\n  };\n}\n\nreturn {\n  json: {\n    ...inputData,\n    code_id: codeRecord.id,\n    is_valid: true\n  }\n};"
      },
      "id": "1abdc184-ab70-46e7-b207-ba4c485963b8",
      "name": "Verify Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        -16
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_valid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "08593da9-939c-4747-b5ac-c6ba9f0bca6b",
      "name": "IF Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -416,
        -16
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE performance_db.email_verification_codes\nSET is_verified = true, verified_at = NOW()\nWHERE id = {{ $json.code_id }}",
        "options": {}
      },
      "id": "58d1b906-9e1c-4291-81bb-f41388fe82ce",
      "name": "Mark Verified",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -192,
        -112
      ],
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE performance_db.email_verification_codes\nSET attempts = {{ $json.attempts }}\nWHERE id = {{ $json.code_id }}",
        "options": {}
      },
      "id": "96671a59-16f8-4685-9d1e-bfda596906ae",
      "name": "Increment Attempts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -192,
        96
      ],
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const inputData = $('Verify Code').first().json;\n\nreturn {\n  json: {\n    success: true,\n    verified: true,\n    message: 'Email verified successfully',\n    data: {\n      email: inputData.email\n    }\n  }\n};"
      },
      "id": "3c40b5f3-f21f-4943-b21a-cdc6c07cfaac",
      "name": "Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        -112
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputData = $('Verify Code').first().json;\nconst remaining = 5 - inputData.attempts;\n\nreturn {\n  json: {\n    success: false,\n    verified: false,\n    message: 'Invalid code. ' + remaining + ' attempts remaining.',\n    data: {\n      email: inputData.email,\n      attempts_remaining: remaining\n    }\n  }\n};"
      },
      "id": "5649313b-9e24-450e-a4de-ecc1d1490aa0",
      "name": "Fail Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        96
      ]
    }
