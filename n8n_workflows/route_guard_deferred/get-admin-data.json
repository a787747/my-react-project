    {
      "parameters": {
        "jsCode": "const guard = $('Run Auth Guard').first().json;\nif (!guard.ok) {\n  return {\n    json: {\n      http_status: guard.status,\n      body: { success: false, error: guard.code, message: guard.message },\n    },\n  };\n}\nreturn {\n  json: {\n    ok: true,\n    sql_grades: \"SELECT * FROM performance_db.grades ORDER BY id ASC;\",\n    sql_settings: \"SELECT * FROM performance_db.global_settings ORDER BY setting_key ASC;\",\n  },\n};"
      },
