{
  "name": "API: Check Evaluated V2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "api/check-evaluated",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "chkeval-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -700,
        0
      ],
      "webhookId": "epe-check-evaluated"
    },
    {
      "parameters": {
        "jsCode": "const request = $input.first().json;\nreturn {\n  json: {\n    authorization: request.headers?.authorization || '',\n    required_roles: [],\n    required_capability: \"\",\n    request,\n  },\n};"
      },
      "id": "chkeval-guard-input",
      "name": "Prepare Guard Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": "L0Zr7nVa8O5YWXd3",
        "options": {}
      },
      "id": "chkeval-run-guard",
      "name": "Run Auth Guard",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        -250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const guard = $('Run Auth Guard').first().json;\nif (!guard.ok) {\n  return {\n    json: {\n      http_status: guard.status,\n      body: { success: false, error: guard.code, message: guard.message },\n    },\n  };\n}\nconst actorId = Number(guard.identity.id);\nreturn {\n  json: {\n    ok: true,\n    sql: `\n      SELECT\n        e.subject_id,\n        e.id AS latest_evaluation_id,\n        e.calculated_score AS last_score,\n        e.updated_at\n      FROM performance_db.evaluations e\n      JOIN performance_db.evaluation_periods ep\n        ON ep.id = e.period_id AND ep.is_active = true AND ep.status = 'active'\n           AND ep.evaluation_started_at IS NOT NULL\n      WHERE e.evaluator_id = ${actorId}\n        AND e.is_self_evaluation = false\n      ORDER BY e.updated_at DESC\n    `,\n  },\n};"
      },
      "id": "chkeval-build",
      "name": "Build Evaluated Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.ok ? $json.sql : 'SELECT NULL::integer AS subject_id WHERE false' }}",
        "options": {}
      },
      "id": "chkeval-query",
      "name": "Load Evaluated",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "VNbfkY8IKbEzn88B",
          "name": "EPE 2026 Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const guard = $('Run Auth Guard').first().json;\nif (!guard.ok) {\n  return {\n    json: {\n      http_status: guard.status,\n      body: { success: false, error: guard.code, message: guard.message },\n    },\n  };\n}\nconst details = $input.all()\n  .map(item => item.json)\n  .filter(item => item.subject_id !== undefined);\nreturn {\n  json: {\n    http_status: 200,\n    body: { success: true, details },\n  },\n};"
      },
      "id": "chkeval-format",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.http_status }}"
        }
      },
      "id": "chkeval-respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        740,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
